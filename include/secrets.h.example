#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h (git-ignored -- never commit real
// values) and fill in your own credentials.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// From @BotFather when you created the bot (see docs/TASKS.md Phase 1).
#define TELEGRAM_BOT_TOKEN "your-bot-token"

// Numeric chat ID -- get it by messaging your bot once, then visiting
// https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and reading the
// "chat":{"id": ...} field from the response.
#define TELEGRAM_CHAT_ID "your-chat-id"

#endif  // SECRETS_H
