# ---------------------------------------------------------------------------
# MineSafe AI — environment template.  Copy to `.env` and fill in the values.
# Never commit real secrets. The mobile app must NOT contain any of these.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Next.js backend / Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC secret for signed session cookies (generate: openssl rand -hex 32)
APP_SECRET=change-me-to-a-long-random-string

# Shared secret the ESP32-S3 sends in the `x-device-key` header.
# Leave empty to allow unauthenticated ingestion in early development only.
DEVICE_API_KEY=

# Helmets self-register on first telemetry. Set to false to require manual
# registration through POST /api/helmets.
AUTO_REGISTER_HELMETS=true

# --- ESP32-S3 / MQTT (optional) -------------------------------------------
# When set, threshold updates are published to the helmet config topic.
MQTT_URL=
MQTT_CONFIG_TOPIC=minesafe/config/thresholds

# --- Push notifications (optional) ----------------------------------------
# Expo Push Service access token. Without it the backend records deliveries as
# `skipped` and clients use the local-notification fallback.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_ENABLED=true
EXPO_PUSH_CRITICAL_ONLY=false

# --- Cron / watchdog ------------------------------------------------------
# Required by POST /api/maintenance/checks when running unattended.
CRON_SECRET=

# --- FastAPI reference backend (backend/) ---------------------------------
# DATABASE_URL=sqlite:///./minesafe.db
# CORS_ORIGINS=http://localhost:8081,http://localhost:3000
